CREATE VIEW USU_VPROVISAO AS SELECT PRR.NUMEMP, EMP.NOMEMP, PRR.TIPCOL, PRR.NUMCAD, FUN.NOMFUN, PRR.MESANO, PRR.TIPPRV, DEF.DESPRV, PRR.SEQPRV, PRR.TIPVAL, PRR.CODRAT, RAT.DESRAT, DET.DESVAL,   
PRR.BASPRV, PRR.PERVAL, PRR.SALANT, PRR.SALTRF, PRR.AJUPRV, PRR.PRVMES, PRR.VALPAG, PRR.VALADT, PRR.VALIND, PRR.PAGMAI, PRR.AJUMAI, PRR.SLDATU, PRR.ANB13S, PRR.VALPAR   
FROM R146PRR PRR   
LEFT JOIN R030EMP EMP ON EMP.NUMEMP = PRR.NUMEMP  
LEFT JOIN R034FUN FUN ON FUN.NUMEMP = PRR.NUMEMP AND FUN.TIPCOL = PRR.TIPCOL AND FUN.NUMCAD = PRR.NUMCAD  
LEFT JOIN R146DEF DEF ON DEF.TIPPRV = PRR.TIPPRV  
LEFT JOIN R146DET DET ON DET.TIPPRV = PRR.TIPPRV AND DET.TIPVAL = PRR.TIPVAL  
LEFT JOIN R020RAT RAT ON RAT.CODRAT = PRR.CODRAT

CREATE VIEW dbo.USU_VLOTE_CRITICA  
AS  
WITH  
LoteAgg AS (  
    SELECT  
        A.NUMEMP, A.CODFIL, A.CODCAL, A.DATLAN, A.TIPCOL, A.NUMCAD,  
        DATEFROMPARTS(YEAR(CAL.PERREF), MONTH(CAL.PERREF), 1)          AS Competencia,  
        COUNT(*)                                                       AS QtdLancamentos,  
        SUM(A.VALLAN)                                                  AS ValorTotalLote,  
        SUM(CASE WHEN A.DEBCRE = 'D' THEN A.VALLAN ELSE 0 END)         AS TotalDebito,  
        SUM(CASE WHEN A.DEBCRE = 'C' THEN A.VALLAN * -1 ELSE 0 END)    AS TotalCredito  
    FROM dbo.R048CTB A  
    JOIN dbo.R044CAL CAL  
        ON CAL.NUMEMP = A.NUMEMP AND CAL.CODCAL = A.CODCAL AND CAL.inicmp >= '2025-08-01'  
    WHERE A.CONGER = '0'  
      AND EXISTS (  
            SELECT 1 FROM dbo.R048CLC B  
            WHERE B.TABEVE = A.TABEVE AND B.CODCLC = A.CODCLC  
          )  
    GROUP BY A.NUMEMP, A.CODFIL, A.CODCAL, A.DATLAN, A.TIPCOL, A.NUMCAD,  
             DATEFROMPARTS(YEAR(CAL.PERREF), MONTH(CAL.PERREF), 1)  
),  
  
LoteNaoProvisao AS (  
    SELECT DISTINCT A.NUMEMP, A.TIPCOL, A.NUMCAD, A.CODCAL  
    FROM dbo.R048CTB A  
    JOIN dbo.R044CAL CAL  
        ON CAL.NUMEMP = A.NUMEMP AND CAL.CODCAL = A.CODCAL AND CAL.inicmp >= '2025-08-01'  
    WHERE A.CONGER = '0'  
      AND EXISTS (  
            SELECT 1 FROM dbo.R048CLC B  
            WHERE B.TABEVE = A.TABEVE AND B.CODCLC = A.CODCLC  
          )  
      AND A.CODCLC NOT BETWEEN 1201 AND 1697  
),  
  
FichaAgg AS (  
    SELECT  
        F.NUMEMP, F.TIPCOL, F.NUMCAD, F.CODCAL,  
        DATEFROMPARTS(YEAR(CAL.PERREF), MONTH(CAL.PERREF), 1)          AS Competencia,  
        SUM(F.VALEVE)                                                  AS ValorTotalFicha,  
        SUM(CASE  
                WHEN EV.TIPEVE IN (1,2) THEN F.VALEVE  
                WHEN EV.TIPEVE = 3 THEN -F.VALEVE  
                ELSE 0  
            END)                                                       AS ValorLiquidoFicha,  
        COUNT(*)                                                       AS QtdEventosFicha,  
        MAX(CASE WHEN EV.TIPEVE IS NULL OR EV.TIPEVE <> 4 THEN 1 ELSE 0 END) AS TemEventoContabilizavel  
    FROM dbo.R046FFR F  
    JOIN dbo.R044CAL CAL  
        ON CAL.NUMEMP = F.NUMEMP AND CAL.CODCAL = F.CODCAL AND CAL.inicmp >= '2025-08-01'  
    LEFT JOIN dbo.R008EVC EV  
        ON EV.CODEVE = F.CODEVE AND EV.CODTAB = 100  
    GROUP BY F.NUMEMP, F.TIPCOL, F.NUMCAD, F.CODCAL,  
             DATEFROMPARTS(YEAR(CAL.PERREF), MONTH(CAL.PERREF), 1)  
),  
  
CCCriticaAgg AS (  
    SELECT  
        NUMEMP, TIPCOL, NUMCAD,  
        MAX(IND_CRITICA_DYNAMICS)               AS FlagCCForaPadrao,  
        STRING_AGG(ORIGENS_SEM_DYNAMICS, ' | ')  AS DetalheOrigensCC  
    FROM dbo.USU_VCRITICACC  
    GROUP BY NUMEMP, TIPCOL, NUMCAD  
),  
  
ProvisaoPorCompetencia AS (  
    SELECT DISTINCT NUMEMP, TIPCOL, NUMCAD, CAST(MESANO AS DATE) AS MesAno  
    FROM dbo.R146PRR  
    WHERE CAST(MESANO AS DATE) >= '2025-08-01'  
),  
  
CCUBase AS (  
    SELECT DISTINCT NUMEMP, CODCCU  
    FROM dbo.R174CND  
),  
  
EventosSemConta AS (  
    SELECT DISTINCT  
        F.NUMEMP, F.TIPCOL, F.NUMCAD, F.CODCAL,  
        EV.CODEVE, EV.DESEVE, EV.CODCLC  
    FROM dbo.R046FFR F  
    JOIN dbo.R044CAL CAL  
        ON CAL.NUMEMP = F.NUMEMP AND CAL.CODCAL = F.CODCAL AND CAL.inicmp >= '2025-08-01'  
    JOIN dbo.R008EVC EV  
        ON EV.CODEVE = F.CODEVE AND EV.CODTAB = 100 AND EV.TIPEVE IN (1,3)  
       AND EV.CODEVE <> 2454  
    LEFT JOIN CCUBase CB  
        ON CB.NUMEMP = F.NUMEMP  
    LEFT JOIN dbo.R174CND R  
        ON R.NUMEMP = CB.NUMEMP AND R.CODCCU = CB.CODCCU  
       AND R.CODCLC = EV.CODCLC AND R.TABEVE = 100  
    WHERE EV.CODCLC IS NULL  
       OR EV.CODCLC = 0  
       OR R.NUMEMP IS NULL  
       OR R.CODCON IS NULL OR LTRIM(RTRIM(R.CODCON)) = ''  
),  
EventosSemContaAgg AS (  
    SELECT  
        NUMEMP, TIPCOL, NUMCAD, CODCAL,  
        STRING_AGG(  
            CONCAT('Evt ', CODEVE, ' - ', DESEVE,  
                   CASE WHEN CODCLC IS NULL OR CODCLC = 0 THEN ' (sem CODCLC)'  
                        ELSE CONCAT(' (CLC ', CODCLC, ' sem conta)') END)  
        , ' | ')                                    AS DetalheEventoSemConta  
    FROM EventosSemConta  
    GROUP BY NUMEMP, TIPCOL, NUMCAD, CODCAL  
)  
  
-- ==========================================================================  
-- PARTE 1: linhas com base no LOTE  
-- ==========================================================================  
SELECT  
    L.NUMEMP,  
    CASE L.NUMEMP WHEN 1 THEN 'ABEC' WHEN 2 THEN 'SOME' WHEN 3 THEN 'UBEE' WHEN 4 THEN 'UNBEC'  
         ELSE CAST(L.NUMEMP AS VARCHAR(10)) END                       AS Mantenedora,  
    L.CODFIL,  
    FIL.NOMFIL,  
    L.CODCAL,  
    L.Competencia,  
    L.DATLAN,  
    L.TIPCOL,  
    L.NUMCAD,  
    FUN.NOMFUN,  
    FUN.TIPCON,  
 TPC.valkey AS DESCR_TIPCON,  
    FUN.DATADM                                                      AS DataAdmissao,  
    CASE WHEN FUN.SITAFA IN (7,17) AND FUN.DATAFA <= EOMONTH(L.Competencia)  
         THEN FUN.DATAFA END                                        AS DataDesligamento,  
    AfastComp.SITAFA                                                 AS CodSituacaoNaCompetencia,  
    SITC.DESSIT                                                      AS SituacaoNaCompetencia,  
    AfastComp.DATAFA                                                 AS DataInicioAfastamentoCompetencia,  
    AfastComp.DATTER                                                 AS DataFimAfastamentoCompetencia,  
    Adm.DiasTrabalhadosComercial,  
    L.QtdLancamentos,  
    L.ValorTotalLote,  
    L.TotalDebito,  
    L.TotalCredito,  
    (L.TotalCredito - (L.TotalDebito * -1))                        AS DiferencaDebitoCredito,  
    CASE WHEN L.TotalCredito <> (L.TotalDebito * -1) THEN 1 ELSE 0 END AS FlagDivergenciaDebCred,  
    ISNULL(CC.FlagCCForaPadrao, 0)                                 AS FlagCCForaPadrao,  
    CC.DetalheOrigensCC,  
    CASE WHEN LNP.NUMEMP IS NOT NULL AND FA.NUMEMP IS NULL THEN 1 ELSE 0 END AS FlagSemFichaFinanceira,  
    FA.ValorTotalFicha,  
    FA.ValorLiquidoFicha,  
    CASE WHEN FA.NUMEMP IS NOT NULL THEN L.ValorTotalLote - FA.ValorTotalFicha END AS DifValorLoteFicha,  
    0                                                               AS FlagSemLoteContabil,  
    -- Só considera "sem Provisão" divergência de fato quando NÃO se enquadra  
    -- em nenhuma exceção (admitido há menos de 15 dias comerciais, Auxílio  
    -- Doença ou Suspensão de Contrato)  
    CASE WHEN PR.NUMEMP IS NULL AND Exc.ExcecaoProvisao = 0 THEN 1 ELSE 0 END AS FlagSemProvisaoNaCompetencia,  
    CASE WHEN ESC.NUMEMP IS NOT NULL THEN 1 ELSE 0 END             AS FlagEventoSemPlanoContas,  
    ESC.DetalheEventoSemConta,  
    'LOTE'                                                          AS OrigemRegistro,  
    STUFF(  
        CASE WHEN L.TotalCredito <> (L.TotalDebito * -1) THEN ',Diferença Débito/Crédito' ELSE '' END +  
        CASE WHEN ISNULL(CC.FlagCCForaPadrao,0) = 1 THEN ',Centro de Custo Fora do Padrão' ELSE '' END +  
        CASE WHEN LNP.NUMEMP IS NOT NULL AND FA.NUMEMP IS NULL THEN  
            ',CODCAL no Lote sem Ficha Financeira (' +  
            CASE WHEN PR.NUMEMP IS NULL AND Exc.ExcecaoProvisao = 0 THEN 'sem Provisão' ELSE 'com Provisão' END + ')'  
        ELSE '' END +  
        CASE WHEN PR.NUMEMP IS NULL AND Exc.ExcecaoProvisao = 0 AND NOT (LNP.NUMEMP IS NOT NULL AND FA.NUMEMP IS NULL)  
             THEN ',' + SP.FraseSemProvisao ELSE '' END +  
        CASE WHEN ESC.NUMEMP IS NOT NULL THEN ',Evento sem Plano de Contas' ELSE '' END  
    , 1, 1, '')                                                     AS TipoCritica,  
    CASE  
        WHEN L.TotalCredito <> (L.TotalDebito * -1)  
          OR ISNULL(CC.FlagCCForaPadrao,0) = 1  
          OR (LNP.NUMEMP IS NOT NULL AND FA.NUMEMP IS NULL)  
          OR (PR.NUMEMP IS NULL AND Exc.ExcecaoProvisao = 0)  
          OR ESC.NUMEMP IS NOT NULL  
        THEN 'DIVERGENTE' ELSE 'OK'  
    END                                  AS StatusGeral  
FROM LoteAgg L  
LEFT JOIN dbo.R030FIL FIL ON FIL.NUMEMP = L.NUMEMP AND FIL.CODFIL = L.CODFIL  
LEFT JOIN dbo.R034FUN FUN ON FUN.NUMEMP = L.NUMEMP AND FUN.TIPCOL = L.TIPCOL AND FUN.NUMCAD = L.NUMCAD  
LEFT JOIN r996lsf TPC ON TPC.lstnam = 'ltipcon' AND TPC.keynam = FUN.TIPCON  
LEFT JOIN FichaAgg FA ON FA.NUMEMP = L.NUMEMP AND FA.TIPCOL = L.TIPCOL AND FA.NUMCAD = L.NUMCAD AND FA.CODCAL = L.CODCAL  
LEFT JOIN LoteNaoProvisao LNP ON LNP.NUMEMP = L.NUMEMP AND LNP.TIPCOL = L.TIPCOL AND LNP.NUMCAD = L.NUMCAD AND LNP.CODCAL = L.CODCAL  
LEFT JOIN CCCriticaAgg CC ON CC.NUMEMP = L.NUMEMP AND CC.TIPCOL = L.TIPCOL AND CC.NUMCAD = L.NUMCAD  
LEFT JOIN ProvisaoPorCompetencia PR ON PR.NUMEMP = L.NUMEMP AND PR.TIPCOL = L.TIPCOL AND PR.NUMCAD = L.NUMCAD AND PR.MesAno = L.Competencia  
LEFT JOIN EventosSemContaAgg ESC ON ESC.NUMEMP = L.NUMEMP AND ESC.TIPCOL = L.TIPCOL AND ESC.NUMCAD = L.NUMCAD AND ESC.CODCAL = L.CODCAL  
OUTER APPLY (  
    SELECT TOP (1) AFA.SITAFA, AFA.DATAFA, AFA.DATTER  
    FROM dbo.R038AFA AFA  
    WHERE AFA.NUMEMP = L.NUMEMP AND AFA.TIPCOL = L.TIPCOL AND AFA.NUMCAD = L.NUMCAD  
      AND AFA.DATAFA <= EOMONTH(L.Competencia)  
      AND (AFA.DATTER >= L.Competencia OR AFA.DATTER = '1900-12-31')  
    ORDER BY AFA.DATAFA DESC  
) AfastComp  
LEFT JOIN dbo.R010SIT SITC ON SITC.CODSIT = AfastComp.SITAFA  
-- Dias trabalhados no mês da admissão, no padrão comercial de 30 dias  
-- (dia 31 é tratado como dia 30)  
OUTER APPLY (  
    SELECT  
        CASE WHEN FUN.DATADM >= L.Competencia AND FUN.DATADM <= EOMONTH(L.Competencia)  
             THEN 30 - (CASE WHEN DAY(FUN.DATADM) > 30 THEN 30 ELSE DAY(FUN.DATADM) END) + 1  
        END AS DiasTrabalhadosComercial  
) Adm  
-- Exceções que tornam "Sem Provisão" esperado/correto (não é divergência)  
OUTER APPLY (  
    SELECT CASE WHEN  
            (Adm.DiasTrabalhadosComercial IS NOT NULL AND Adm.DiasTrabalhadosComercial < 15)  
         OR (SITC.DESSIT LIKE N'%AUX%LIO%DOEN%')  
         OR (SITC.DESSIT LIKE N'%SUSPENS%CONTRAT%')  
        THEN 1 ELSE 0 END AS ExcecaoProvisao  
) Exc  
OUTER APPLY (  
    SELECT CASE  
        WHEN PR.NUMEMP IS NULL AND Exc.ExcecaoProvisao = 0 AND AfastComp.SITAFA IS NOT NULL AND AfastComp.SITAFA <> 1  
            THEN CONCAT('Sem Provisão na Competência (Situação: ', ISNULL(SITC.DESSIT,'Não Identificada'), ')')  
        WHEN PR.NUMEMP IS NULL AND Exc.ExcecaoProvisao = 0  
            THEN 'Sem Provisão na Competência'  
        ELSE NULL  
    END AS FraseSemProvisao  
) SP  
  
UNION ALL  
  
-- ==========================================================================  
-- PARTE 2: linhas com base na FICHA FINANCEIRA sem lançamento REAL no Lote  
-- ==========================================================================  
SELECT  
    FA.NUMEMP,  
    CASE FA.NUMEMP WHEN 1 THEN 'ABEC' WHEN 2 THEN 'SOME' WHEN 3 THEN 'UBEE' WHEN 4 THEN 'UNBEC'  
         ELSE CAST(FA.NUMEMP AS VARCHAR(10)) END                      AS Mantenedora,  
    FUN.CODFIL,  
    FIL.NOMFIL,  
    FA.CODCAL,  
    FA.Competencia,  
    CAST(NULL AS DATETIME)                                         AS DATLAN,  
    FA.TIPCOL,  
    FA.NUMCAD,  
    FUN.NOMFUN,  
    FUN.TIPCON,  
 TPC.valkey AS DESCR_TIPCON,  
    FUN.DATADM                                                      AS DataAdmissao,  
    CASE WHEN FUN.SITAFA IN (7,17) AND FUN.DATAFA <= EOMONTH(FA.Competencia)  
         THEN FUN.DATAFA END                                        AS DataDesligamento,  
    AfastComp.SITAFA                                                 AS CodSituacaoNaCompetencia,  
    SITC.DESSIT                                                      AS SituacaoNaCompetencia,  
    AfastComp.DATAFA                                                 AS DataInicioAfastamentoCompetencia,  
    AfastComp.DATTER                                                 AS DataFimAfastamentoCompetencia,  
    Adm.DiasTrabalhadosComercial,  
    CAST(NULL AS INT)                                              AS QtdLancamentos,  
    CAST(NULL AS DECIMAL(18,2))                                    AS ValorTotalLote,  
    CAST(NULL AS DECIMAL(18,2))                                    AS TotalDebito,  
    CAST(NULL AS DECIMAL(18,2))                                    AS TotalCredito,  
    CAST(NULL AS DECIMAL(18,2))                                    AS DiferencaDebitoCredito,  
    0                                                               AS FlagDivergenciaDebCred,  
    ISNULL(CC.FlagCCForaPadrao, 0)                                 AS FlagCCForaPadrao,  
    CC.DetalheOrigensCC,  
    0                                                               AS FlagSemFichaFinanceira,  
    FA.ValorTotalFicha,  
    FA.ValorLiquidoFicha,  
    CAST(NULL AS DECIMAL(18,2))                                    AS DifValorLoteFicha,  
    1                                                               AS FlagSemLoteContabil,  
    CASE WHEN PR.NUMEMP IS NULL AND Exc.ExcecaoProvisao = 0 THEN 1 ELSE 0 END AS FlagSemProvisaoNaCompetencia,  
    CASE WHEN ESC.NUMEMP IS NOT NULL THEN 1 ELSE 0 END             AS FlagEventoSemPlanoContas,  
    ESC.DetalheEventoSemConta,  
    'FICHA'                                                         AS OrigemRegistro,  
    STUFF(  
        ',CODCAL na Ficha Financeira sem Lançamento no Lote Contábil' +  
        CASE WHEN ISNULL(CC.FlagCCForaPadrao,0) = 1 THEN ',Centro de Custo Fora do Padrão' ELSE '' END +  
        CASE WHEN PR.NUMEMP IS NULL AND Exc.ExcecaoProvisao = 0 THEN ',' + SP.FraseSemProvisao ELSE '' END +  
        CASE WHEN ESC.NUMEMP IS NOT NULL THEN ',Evento sem Plano de Contas' ELSE '' END  
    , 1, 1, '')                                                     AS TipoCritica,  
    'DIVERGENTE'                                                    AS StatusGeral  
FROM FichaAgg FA  
LEFT JOIN dbo.R034FUN FUN ON FUN.NUMEMP = FA.NUMEMP AND FUN.TIPCOL = FA.TIPCOL AND FUN.NUMCAD = FA.NUMCAD  
LEFT JOIN r996lsf TPC ON TPC.lstnam = 'ltipcon' AND TPC.keynam = FUN.TIPCON  
LEFT JOIN dbo.R030FIL FIL ON FIL.NUMEMP = FA.NUMEMP AND FIL.CODFIL = FUN.CODFIL  
LEFT JOIN CCCriticaAgg CC ON CC.NUMEMP = FA.NUMEMP AND CC.TIPCOL = FA.TIPCOL AND CC.NUMCAD = FA.NUMCAD  
LEFT JOIN ProvisaoPorCompetencia PR ON PR.NUMEMP = FA.NUMEMP AND PR.TIPCOL = FA.TIPCOL AND PR.NUMCAD = FA.NUMCAD AND PR.MesAno = FA.Competencia  
LEFT JOIN EventosSemContaAgg ESC ON ESC.NUMEMP = FA.NUMEMP AND ESC.TIPCOL = FA.TIPCOL AND ESC.NUMCAD = FA.NUMCAD AND ESC.CODCAL = FA.CODCAL  
OUTER APPLY (  
    SELECT TOP (1) AFA.SITAFA, AFA.DATAFA, AFA.DATTER  
    FROM dbo.R038AFA AFA  
    WHERE AFA.NUMEMP = FA.NUMEMP AND AFA.TIPCOL = FA.TIPCOL AND AFA.NUMCAD = FA.NUMCAD  
      AND AFA.DATAFA <= EOMONTH(FA.Competencia)  
      AND (AFA.DATTER >= FA.Competencia OR AFA.DATTER = '1900-12-31')  
    ORDER BY AFA.DATAFA DESC  
) AfastComp  
LEFT JOIN dbo.R010SIT SITC ON SITC.CODSIT = AfastComp.SITAFA  
OUTER APPLY (  
    SELECT  
        CASE WHEN FUN.DATADM >= FA.Competencia AND FUN.DATADM <= EOMONTH(FA.Competencia)  
             THEN 30 - (CASE WHEN DAY(FUN.DATADM) > 30 THEN 30 ELSE DAY(FUN.DATADM) END) + 1  
        END AS DiasTrabalhadosComercial  
) Adm  
OUTER APPLY (  
    SELECT CASE WHEN  
            (Adm.DiasTrabalhadosComercial IS NOT NULL AND Adm.DiasTrabalhadosComercial < 15)  
         OR (SITC.DESSIT LIKE N'%AUX%LIO%DOEN%')  
         OR (SITC.DESSIT LIKE N'%SUSPENS%CONTRAT%')  
        THEN 1 ELSE 0 END AS ExcecaoProvisao  
) Exc  
OUTER APPLY (  
    SELECT CASE  
        WHEN PR.NUMEMP IS NULL AND Exc.ExcecaoProvisao = 0 AND AfastComp.SITAFA IS NOT NULL AND AfastComp.SITAFA <> 1  
            THEN CONCAT('Sem Provisão na Competência (Situação: ', ISNULL(SITC.DESSIT,'Não Identificada'), ')')  
        WHEN PR.NUMEMP IS NULL AND Exc.ExcecaoProvisao = 0  
            THEN 'Sem Provisão na Competência'  
        ELSE NULL  
    END AS FraseSemProvisao  
) SP  
WHERE FA.TemEventoContabilizavel = 1  
  AND ISNULL(FA.ValorLiquidoFicha, 0) <> 0  
  AND NOT EXISTS (  
    SELECT 1 FROM LoteNaoProvisao LNP  
    WHERE LNP.NUMEMP = FA.NUMEMP AND LNP.TIPCOL = FA.TIPCOL AND LNP.NUMCAD = FA.NUMCAD AND LNP.CODCAL = FA.CODCAL  
);
